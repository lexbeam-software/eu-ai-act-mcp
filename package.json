{
  "name": "@lexbeam-software/eu-ai-act-mcp",
  "version": "1.5.1",
  "description": "EU AI Act compliance MCP server with bounded system assessment, structured classification, article grounding, GPAI, Art. 6(3), Annex III/IV, deadlines, obligations, penalties, and FAQ. By Lexbeam Software.",
  "keywords": [
    "mcp",
    "eu-ai-act",
    "ai-act",
    "compliance",
    "legal-tech",
    "ai-governance",
    "risk-assessment",
    "regulation",
    "ki-verordnung"
  ],
  "author": "Lexbeam Software <info@lexbeam.com> (https://lexbeam.com)",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "lexbeam-eu-ai-act-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "verify": "node scripts/verify.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "check:links": "node scripts/check-links.mjs",
    "start": "node dist/index.js",
    "start:http": "node dist/http.js",
    "dev": "tsx src/index.ts",
    "dev:http": "tsx src/http.ts",
    "prepublishOnly": "npm run verify"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "typescript": "^5.8.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lexbeam-software/eu-ai-act-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/lexbeam-software/eu-ai-act-mcp/issues"
  },
  "homepage": "https://github.com/lexbeam-software/eu-ai-act-mcp#readme",
  "engines": {
    "node": ">=20.0.0"
  }
}
